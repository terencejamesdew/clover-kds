# Copy this file to .env and fill in your values.
# Leave CLOVER_API_TOKEN empty to run with sample (demo) orders.

# Clover web dashboard → Account & Setup → Merchants (13-character ID, also in your dashboard URL)
CLOVER_MERCHANT_ID=
# Clover web dashboard → Account & Setup → Business Operations → API Tokens → Create new token
# Give it "Orders: Read" (plus "Employees: Read" / "Customers: Read" for server and customer names, "Inventory: Read" for food vs drinks)
CLOVER_API_TOKEN=
# us (also Canada), eu, la, or sandbox
CLOVER_REGION=us

PORT=3000
# The shop's time zone, so "today's orders" resets at local midnight (cloud hosts run on UTC)
TIMEZONE=America/New_York
# MySQL / MariaDB for ticket history: every order, its kitchen stage and timestamps. Tables are created automatically.
# Format: mysql://user:password@host:port/database?ssl-mode=REQUIRED
DATABASE_URL=
# Only used when DATABASE_URL is empty: where ticket stages are saved (default ./data)
DATA_DIR=
# How often to check Clover for new/changed orders, in seconds (minimum 2)
POLL_SECONDS=5

# Optional: only if you set up Clover webhooks (see README)
CLOVER_WEBHOOK_AUTH=
